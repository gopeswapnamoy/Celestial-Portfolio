generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Project {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  category        String
  description     String
  longDescription String
  stack           String
  status          String
  liveUrl         String
  githubUrl       String
  accent          String
  artifactNo      String
  highlights      String
  featured        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Skill {
  id          String   @id @default(cuid())
  title       String   @unique
  category    String
  mastery     Int
  description String
  skills      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  ipHash    String?
  userAgent String?
  createdAt DateTime @default(now())
  readAt    DateTime?

  @@index([createdAt])
  @@index([email])
}

model TimelineEvent {
  id          String   @id @default(cuid())
  year        String
  title       String
  description String
  sortOrder   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
